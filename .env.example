# BharatSearch environment configuration.
# Copy to .env and adjust for your profile: lite | standard | full

PROFILE=lite

# Model server (OpenAI-compatible endpoint)
MODEL_SERVER_URL=http://localhost:8000
MODEL_NAME=stub

# Service ports
OPENSEARCH_PORT=9200
QDRANT_PORT=6333
REDIS_PORT=6379
KAFKA_PORT=9092
STUB_INFERENCE_PORT=8000
